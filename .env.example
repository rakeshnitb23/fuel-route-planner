POSTGRES_DB=spotter
POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# AI strategy picker (POST /api/route/smart/). Optional: with no key it falls back to
# lowest_cost. Provider: openrouter (default) or anthropic.
STRATEGY_ROUTER_PROVIDER=openrouter
OPENROUTER_API_KEY=
STRATEGY_ROUTER_MODEL=anthropic/claude-haiku-5.5
# Only used when STRATEGY_ROUTER_PROVIDER=anthropic (then set STRATEGY_ROUTER_MODEL=claude-haiku-5-5)
ANTHROPIC_API_KEY=
