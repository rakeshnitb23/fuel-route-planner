# Production settings for docker-compose.prod.yml.
# On the server: cp .env.production.example .env, then replace every "change-me".

# Your domain, pointing at the server's Elastic IP (e.g. fuelroute.duckdns.org).
DOMAIN=change-me.duckdns.org

DEBUG=False
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

POSTGRES_DB=spotter
POSTGRES_USER=spotter
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# AI strategy picker (POST /api/route/smart/). Empty key: falls back to lowest_cost.
STRATEGY_ROUTER_PROVIDER=openrouter
OPENROUTER_API_KEY=
STRATEGY_ROUTER_MODEL=anthropic/claude-haiku-5.5

# Per-IP rate limits.
SMART_RATE_LIMIT=20/hour
ROUTE_RATE_LIMIT=120/hour
